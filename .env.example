# Copy this file to ".env" and fill in ONE provider's keys.
# .env is git-ignored, so your keys are never pushed to GitHub.

# Which OTP provider to use: firebase | textbee | smsgate | infobip | vonage | twilio
EXPO_PUBLIC_OTP_PROVIDER=firebase

# --- Firebase Phone Auth (free Spark plan, no card) ---
# Firebase Console → Project settings → General → Web API key
# Free plan: add your number under Authentication → Sign-in method → Phone → "Phone numbers for testing"
EXPO_PUBLIC_FIREBASE_API_KEY=

# --- textbee.dev (free, no card, works in Pakistan via your own Android SIM) ---
# https://textbee.dev → Dashboard: generate API key, register phone with the textbee app, copy Device ID
EXPO_PUBLIC_TEXTBEE_API_KEY=
EXPO_PUBLIC_TEXTBEE_DEVICE_ID=

# --- SMS Gateway for Android (free, open source) --- https://sms-gate.app
# App → Cloud Server → Online → copy username/password
EXPO_PUBLIC_SMSGATE_USERNAME=
EXPO_PUBLIC_SMSGATE_PASSWORD=

# --- Infobip (free 60-day trial) ---
EXPO_PUBLIC_INFOBIP_BASE_URL=
EXPO_PUBLIC_INFOBIP_API_KEY=

# --- Vonage (free €2 credit) ---
EXPO_PUBLIC_VONAGE_API_KEY=
EXPO_PUBLIC_VONAGE_API_SECRET=

# --- Twilio (free trial) ---
EXPO_PUBLIC_TWILIO_ACCOUNT_SID=
EXPO_PUBLIC_TWILIO_AUTH_TOKEN=
EXPO_PUBLIC_TWILIO_VERIFY_SERVICE_SID=
