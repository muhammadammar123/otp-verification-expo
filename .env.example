# Copy this file to ".env" and fill in ONE provider's keys.
# .env is git-ignored, so your keys are never pushed to GitHub.

# Which SMS OTP provider to use: infobip | vonage | twilio
EXPO_PUBLIC_OTP_PROVIDER=infobip

# --- Infobip (free 60-day trial, no card) --- https://www.infobip.com/signup
# Homepage of the Infobip portal shows your API key and Base URL (e.g. abcd12.api.infobip.com)
EXPO_PUBLIC_INFOBIP_BASE_URL=xxxxxx.api.infobip.com
EXPO_PUBLIC_INFOBIP_API_KEY=

# --- Vonage (free €2 credit, no card) --- https://dashboard.nexmo.com/sign-up
EXPO_PUBLIC_VONAGE_API_KEY=
EXPO_PUBLIC_VONAGE_API_SECRET=

# --- Twilio (free trial credit, no card) --- https://www.twilio.com/try-twilio
EXPO_PUBLIC_TWILIO_ACCOUNT_SID=
EXPO_PUBLIC_TWILIO_AUTH_TOKEN=
EXPO_PUBLIC_TWILIO_VERIFY_SERVICE_SID=
